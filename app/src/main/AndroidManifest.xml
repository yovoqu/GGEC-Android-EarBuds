<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音通话：采集与扬声器路由。相机权限不申请：通话中插入照片这轮只有入口，没有实现。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 13+ 发送通知（下载/更新完成提示由 lib_common 的 DownloadNotificationController 触发）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- APP 更新：安装/检查所需权限（REQUEST_INSTALL_PACKAGES、ACCESS_NETWORK_STATE）由
         biz_appupdate 自己的 manifest 合并进来，本文件不重复声明；存储权限不需要，因为更新包
         落在应用私有外部目录（biz_appupdate 的 APP_PRIVATE 下载目录）。 -->

    <!-- enableOnBackInvokedCallback 必须显式打开：YoUI 的对话框、面板和菜单靠它接管返回键，
         不写时返回键会越过它们直接关掉整个页面。 -->
    <application
        android:name=".EarbudsApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GGECEarBuds">
        <activity
            android:name=".ui.shell.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.ggec.earbuds.main"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通话页是全屏单页：竖屏、不参与多任务快照的缩略图（里面可能有正在念的内容）。 -->
        <activity
            android:name=".ui.ai.chat.AiChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ai.call.AiCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ai.settings.AiSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ai.settings.AiPlatformActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.device.scan.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.device.settings.DeviceSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.device.find.FindDeviceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.device.wear.WearSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.device.record.RecordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Record 独立入口：单独 taskAffinity，避免点图标时复用主壳任务栈而打开 MainActivity。 -->
        <activity
            android:name=".record.ui.RecordMainActivity"
            android:exported="true"
            android:label="@string/record_app_label"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.ggec.earbuds.record"
            android:theme="@style/Theme.GGECRecord">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- APP 更新：安装器只能读到 FileProvider 授出的 Uri，不暴露应用私有外部目录之外的路径。
             authority 与 AppUpdateProviders 的推导值（packageName + ".fileprovider"）一一对应。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths_update" />
        </provider>
    </application>

</manifest>
