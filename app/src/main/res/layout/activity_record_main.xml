<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/record_bg">

    <!-- 视频主舞台 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="260dp"
        android:background="@color/record_video_placeholder">

        <TextureView
            android:id="@+id/record_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/record_video_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/record_video_placeholder"
            android:textColor="@color/record_text_secondary"
            android:textSize="14sp" />

        <!-- 顶部信息条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/record_overlay"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/record_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/record_title"
                android:textColor="@color/record_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/record_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/record_status_idle"
                android:textColor="@color/record_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/record_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/record_chip_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="@string/record_stats_idle"
                android:textColor="@color/record_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 字幕叠在画面底部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/record_subtitle_scrim"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp">

            <ScrollView
                android:id="@+id/record_subtitle_scroll"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/record_subtitle_final"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/record_text_primary"
                    android:textSize="14sp" />
            </ScrollView>

            <TextView
                android:id="@+id/record_subtitle_partial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/record_accent"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/record_panel_bg"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_codec_h264"
                style="@style/Widget.Record.Chip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/record_codec_h264" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_codec_h265"
                style="@style/Widget.Record.Chip"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/record_codec_h265" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/record_mute"
                    style="@style/Widget.Record.Chip"
                    android:layout_width="wrap_content"
                    android:text="@string/record_mute" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/record_asr_toggle"
                    style="@style/Widget.Record.Chip"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/record_asr_off" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/record_asr_model"
                    style="@style/Widget.Record.Chip"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/record_asr_model_zipformer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/record_asr_clear"
                    style="@style/Widget.Record.Chip"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/record_asr_clear" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/record_capture"
            style="@style/Widget.Record.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="@string/record_capture_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_scan"
                style="@style/Widget.Record.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/record_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_stop_scan"
                style="@style/Widget.Record.Secondary"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/record_stop_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/record_disconnect"
                style="@style/Widget.Record.Secondary"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/record_disconnect" />
        </LinearLayout>

        <TextView
            android:id="@+id/record_device_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/record_nearby_title"
            android:textColor="@color/record_text_secondary"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/record_device_list"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="8dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</FrameLayout>
