<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GGECRecord" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/record_bg</item>
        <item name="android:navigationBarColor">@color/record_panel</item>
        <item name="android:windowBackground">@color/record_bg</item>
        <item name="colorPrimary">@color/record_accent</item>
        <item name="colorOnPrimary">@color/record_bg</item>
        <item name="colorSurface">@color/record_panel</item>
        <item name="colorOnSurface">@color/record_text_primary</item>
        <item name="android:textColorPrimary">@color/record_text_primary</item>
        <item name="android:textColorSecondary">@color/record_text_secondary</item>
    </style>

    <style name="Widget.Record.Chip" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="backgroundTint">@color/record_chip</item>
        <item name="android:textColor">@color/record_text_primary</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Widget.Record.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/record_accent</item>
        <item name="android:textColor">@color/record_bg</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Record.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/record_panel_stroke</item>
        <item name="android:textColor">@color/record_text_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
