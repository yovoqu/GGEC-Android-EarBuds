<?xml version="1.0" encoding="utf-8"?>
<!--
  通话页专用文案。单独一个文件，避免和 strings.xml 并行冲突；
  上线前如需合并，直接搬进去即可，键名已经带 ai_call_ 前缀。
-->
<resources>
    <!-- 对话页标题行里的入口，按钮本身没有文字，只做无障碍标签 -->
    <string name="ai_call_entry">语音通话</string>
    <string name="ai_call_failed_action">去设置</string>
    <!-- 页头 -->
    <string name="ai_call_title">语音通话</string>
    <string name="ai_call_mode_realtime">实时语音对话</string>

    <!-- 状态：一行只说明"它现在在做什么"，不写"请稍候"这类空话 -->
    <string name="ai_call_phase_connecting">正在接通</string>
    <string name="ai_call_phase_listening">正在聆听</string>
    <string name="ai_call_phase_thinking">正在思考</string>
    <string name="ai_call_phase_speaking">正在说话</string>
    <string name="ai_call_phase_muted">已静音</string>
    <string name="ai_call_phase_failed">通话已断开</string>
    <string name="ai_call_phase_ended">通话已结束</string>

    <!-- 麦克风不可用：说明原因，不让页面停在"正在聆听"上骗人 -->
    <string name="ai_call_no_permission">没有麦克风权限，听不到你说话</string>

    <!-- 底部按钮：按钮上写动作，读屏读的是当前动作 -->
    <string name="ai_call_camera">拍照</string>
    <string name="ai_call_camera_unavailable">通话中插入照片还没开放</string>
    <string name="ai_call_mute">静音</string>
    <string name="ai_call_unmute">取消静音</string>
    <string name="ai_call_speaker_to_earpiece">切到听筒</string>
    <string name="ai_call_speaker_to_speaker">切到扬声器</string>
    <string name="ai_call_hang_up">挂断</string>
    <string name="ai_call_close">结束通话</string>
    <string name="ai_call_interrupt">打断回答</string>

    <string name="ai_call_retry">重试</string>
</resources>
